rules_version = '2';

// KDTIME Firestore 보안 규칙 — 1단계 C
// - 읽기: Firebase 로그인(익명 포함)을 마친 화면
// - 저장: 로그인 서버가 준 계정 로그인(custom)만
// - 계정 원본(kd_accounts)·그 조각·백업: 브라우저 접근 금지(서버만). 화면은 공개용 목록(kd_accounts_public)만 읽음
// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여 넣고 '게시'를 누릅니다.
// (로그인 서버는 관리자 권한으로 접근하므로 이 규칙과 상관없이 동작합니다.)
service cloud.firestore {
  match /databases/{database}/documents {

    // 서버 전용: 비밀번호 암호·간편 로그인 연결·로그인 실패 기록
    match /kd_auth/{docId} {
      allow read, write: if false;
    }

    match /kd_timetable_kv/{docId} {
      // 계정 원본과 그 조각·백업(평문 비밀번호가 남아 있을 수 있는 예전 백업 포함)
      function accountsPrivate() {
        return docId == 'kd_accounts'
          || docId.matches('kd_accounts__chunk__.*')
          || docId.matches('__bk__kd_accounts__.*')
          || docId == '__bkindex__kd_accounts';
      }
      // 서버만 쓰는 곳: 공개용 계정 목록
      function serverWritten() {
        return docId == 'kd_accounts_public' || docId.matches('kd_accounts_public__chunk__.*');
      }
      allow read: if request.auth != null && !accountsPrivate();
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && !accountsPrivate() && !serverWritten();
    }

    // 그 밖의 모든 곳은 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
